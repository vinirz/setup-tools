# Gerado por setup-zsh. Ajustes da maquina ficam em ~/.zshrc.local (nao sobrescrito).
export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="spaceship"

plugins=(
  git
  zsh-autosuggestions
  zsh-syntax-highlighting
)

# ===== VESPER COLORS =====

SPACESHIP_USER_COLOR="#E6B99D"
SPACESHIP_DIR_COLOR="#ACA1CF"
SPACESHIP_HOST_COLOR="#90B99F"

SPACESHIP_GIT_BRANCH_COLOR="#E29ECA"
SPACESHIP_GIT_STATUS_COLOR="#EA83A5"

SPACESHIP_NODE_COLOR="#90B99F"

SPACESHIP_CHAR_COLOR_SUCCESS="#90B99F"
SPACESHIP_CHAR_COLOR_FAILURE="#F5A191"

SPACESHIP_TIME_COLOR="#505050"

# ===== SYMBOLS (Nerd Font) =====

SPACESHIP_GIT_SYMBOL="@GIT_SYMBOL@"
SPACESHIP_NODE_SYMBOL="@NODE_SYMBOL@"

# ===== LAYOUT =====

SPACESHIP_USER_SHOW=always
SPACESHIP_PROMPT_ADD_NEWLINE=false
SPACESHIP_CHAR_SUFFIX=" "
SPACESHIP_NODE_SHOW=true
SPACESHIP_EXEC_TIME_SHOW=false

# ===== PROMPT ORDER =====

SPACESHIP_PROMPT_ORDER=(
  user
  dir
  host
  git
  hg
  exec_time
  line_sep
  jobs
  exit_code
  char
)

source "$ZSH/oh-my-zsh.sh"

# ===== PATH =====

export PATH="$HOME/.local/bin:$PATH"

# ===== ALIASES =====

if command -v eza >/dev/null; then
  alias ls="eza --icons"
  alias ll="eza -lah --icons"
fi

if command -v batcat >/dev/null; then
  alias cat="batcat --style=plain"
fi

alias gfc="git fetch && git checkout"

# ===== FUNCOES =====

whouses() {
  lsof -i :"$1"
}

# ===== NVM (so carrega se instalado) =====

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && . "$NVM_DIR/bash_completion"

# ===== AJUSTES PESSOAIS / DA MAQUINA =====

[ -f "$HOME/.zshrc.local" ] && . "$HOME/.zshrc.local"
